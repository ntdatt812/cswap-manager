  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "build:tests": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p .",
    "bundle": "node esbuild.mjs",
    "compile": "npm run typecheck && npm run bundle",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint .",
    "test": "npm run build:tests && node --test \"out/test/unit/**/*.test.js\"",
    "test:live": "npm run build:tests && node --test \"out/test/live/**/*.test.js\"",
    "test:integration": "npm run build:tests && npm run bundle && vscode-test",
    "package": "node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "package:vsix": "npm run typecheck && vsce package",
    "l10n:extract": "npm run build:tests && node out/test/helpers/l10nExtract.js"
  },

{
  "name": "cswap-manager",
  "displayName": "Cswap Manager",
  "description": "%extension.description%",
  "version": "0.14.0",
  "publisher": "nguyenthanhdat",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntdatt812/cswap-manager.git"
  },
  "bugs": {
    "url": "https://github.com/ntdatt812/cswap-manager/issues"
  },
  "homepage": "https://github.com/ntdatt812/cswap-manager#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "cswap",
    "claude-swap",
    "account switcher",
    "multi-account",
    "accounts",
    "usage",
    "quota",
    "rate limit",
    "usage limit"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "cswapManager.confirmSwitch",
        "cswapManager.autoSwitch.mode"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cswapManager",
          "title": "Cswap Manager",
          "icon": "resources/cswap.svg"
        }
      ]
    },
    "views": {
      "cswapManager": [
        {
          "id": "cswapManager.accounts",
          "name": "%view.accounts.name%",
          "icon": "resources/cswap.svg",
          "contextualTitle": "Cswap Manager"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "cswapManager.gettingStarted",
        "title": "%walkthrough.gettingStarted.title%",
        "description": "%walkthrough.gettingStarted.description%",
        "steps": [
          {
            "id": "installCswap",
            "title": "%walkthrough.installCswap.title%",
            "description": "%walkthrough.installCswap.description%",
            "media": {
              "svg": "media/walkthrough/install.svg",
              "altText": "%walkthrough.installCswap.altText%"
            },
            "completionEvents": [
              "onCommand:cswapManager.refresh",
              "onContext:cswapManager.viewState == ready || cswapManager.viewState == empty"
            ]
          },
          {
            "id": "openAccounts",
            "title": "%walkthrough.openAccounts.title%",
            "description": "%walkthrough.openAccounts.description%",
            "media": {
              "svg": "media/walkthrough/accounts.svg",
              "altText": "%walkthrough.openAccounts.altText%"
            },
            "completionEvents": [
              "onView:cswapManager.accounts"
            ]
          },
          {
            "id": "addAccounts",
            "title": "%walkthrough.addAccounts.title%",
            "description": "%walkthrough.addAccounts.description%",
            "media": {
              "svg": "media/walkthrough/add-account.svg",
              "altText": "%walkthrough.addAccounts.altText%"
            },
            "completionEvents": [
              "onCommand:cswapManager.addAccount"
            ]
          },
          {
            "id": "switchAccounts",
            "title": "%walkthrough.switchAccounts.title%",
            "description": "%walkthrough.switchAccounts.description%",
            "media": {
              "svg": "media/walkthrough/switch.svg",
              "altText": "%walkthrough.switchAccounts.altText%"
            },
            "completionEvents": [
              "onCommand:cswapManager.quickSwitch",
              "onCommand:cswapManager.switchNextAvailable",
              "onCommand:cswapManager.toggleSwitchAtLimit"
            ]
          },
          {
            "id": "dashboardAndSettings",
            "title": "%walkthrough.dashboardAndSettings.title%",
            "description": "%walkthrough.dashboardAndSettings.description%",
            "media": {
              "image": {
                "dark": "images/dashboard-dark.png",
                "light": "images/dashboard-light.png",
                "hc": "images/dashboard-dark.png",
                "hcLight": "images/dashboard-light.png"
              },
              "altText": "%walkthrough.dashboardAndSettings.altText%"
            },
            "completionEvents": [
              "onCommand:cswapManager.openDashboard"
            ]
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.loading%",
        "when": "!cswapManager.viewState || cswapManager.viewState == loading"
      },
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.notFound%",
        "when": "cswapManager.viewState == notFound"
      },
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.invalidSetting%",
        "when": "cswapManager.viewState == invalidSetting"
      },
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.unsupportedExecutable%",
        "when": "cswapManager.viewState == unsupportedExecutable"
      },
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.error%",
        "when": "cswapManager.viewState == error"
      },
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.empty%",
        "when": "cswapManager.viewState == empty"
      },
      {
        "view": "cswapManager.accounts",
        "contents": "%welcome.filteredEmpty%",
        "when": "cswapManager.viewState == filteredEmpty"
      }
    ],
    "commands": [
      {
        "command": "cswapManager.refresh",
        "title": "%command.refresh.title%",
        "category": "Cswap",
        "icon": "$(refresh)"
      },
      {
        "command": "cswapManager.showDiagnostics",
        "title": "%command.showDiagnostics.title%",
        "category": "Cswap",
        "icon": "$(pulse)"
      },
      {
        "command": "cswapManager.openSettings",
        "title": "%command.openSettings.title%",
        "category": "Cswap",
        "icon": "$(gear)"
      },
      {
        "command": "cswapManager.quickSettings",
        "title": "%command.quickSettings.title%",
        "category": "Cswap",
        "icon": "$(settings-gear)"
      },
      {
        "command": "cswapManager.filterAccounts",
        "title": "%command.filterAccounts.title%",
        "category": "Cswap",
        "icon": "$(filter)"
      },
      {
        "command": "cswapManager.clearFilter",
        "title": "%command.clearFilter.title%",
        "category": "Cswap",
        "icon": "$(filter-filled)"
      },
      {
        "command": "cswapManager.sortAccounts",
        "title": "%command.sortAccounts.title%",
        "category": "Cswap",
        "icon": "$(list-ordered)"
      },
      {
        "command": "cswapManager.quickSwitch",
        "title": "%command.quickSwitch.title%",
        "category": "Cswap",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "cswapManager.switchBest",
        "title": "%command.switchBest.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.switchNextAvailable",
        "title": "%command.switchNextAvailable.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.switchToAccount",
        "title": "%command.switchToAccount.title%",
        "category": "Cswap",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "cswapManager.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "Cswap",
        "icon": "$(dashboard)"
      },
      {
        "command": "cswapManager.showAccountDetails",
        "title": "%command.showAccountDetails.title%",
        "category": "Cswap",
        "icon": "$(info)"
      },
      {
        "command": "cswapManager.manageAccount",
        "title": "%command.manageAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.openClaudeAs",
        "title": "%command.openClaudeAs.title%",
        "category": "Cswap",
        "icon": "$(terminal)"
      },
      {
        "command": "cswapManager.openClaudeForProject",
        "title": "%command.openClaudeForProject.title%",
        "category": "Cswap",
        "icon": "$(terminal)"
      },
      {
        "command": "cswapManager.assignProjectAccount",
        "title": "%command.assignProjectAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.checkCswapUpdate",
        "title": "%command.checkCswapUpdate.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.installCswap",
        "title": "%command.installCswap.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.clearUsageHistory",
        "title": "%command.clearUsageHistory.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.addAccount",
        "title": "%command.addAccount.title%",
        "category": "Cswap",
        "icon": "$(add)"
      },
      {
        "command": "cswapManager.removeAccount",
        "title": "%command.removeAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.exportAccounts",
        "title": "%command.exportAccounts.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.exportAccount",
        "title": "%command.exportAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.importAccounts",
        "title": "%command.importAccounts.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.saveUsageReadings",
        "title": "%command.saveUsageReadings.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.importUsage",
        "title": "%command.importUsage.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.setDisplayName",
        "title": "%command.setDisplayName.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.disableAccount",
        "title": "%command.disableAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.enableAccount",
        "title": "%command.enableAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.setThreshold",
        "title": "%command.setThreshold.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.clearThreshold",
        "title": "%command.clearThreshold.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.moveAccount",
        "title": "%command.moveAccount.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.autoSwitch",
        "title": "%command.autoSwitch.title%",
        "category": "Cswap",
        "icon": "$(sync)"
      },
      {
        "command": "cswapManager.toggleSwitchAtLimit",
        "title": "%command.toggleSwitchAtLimit.title%",
        "category": "Cswap"
      },
      {
        "command": "cswapManager.autoSwitchPreview",
        "title": "%command.autoSwitchPreview.title%",
        "category": "Cswap"
      }
    ],
    "icons": {
      "cswap-slant-0": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E000"
        }
      },
      "cswap-slant-1": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E001"
        }
      },
      "cswap-slant-2": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E002"
        }
      },
      "cswap-slant-3": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E003"
        }
      },
      "cswap-slant-4": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E004"
        }
      },
      "cswap-slant-5": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E005"
        }
      },
      "cswap-slant-6": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E006"
        }
      },
      "cswap-slant-7": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E007"
        }
      },
      "cswap-slant-8": {
        "description": "%icon.slant.description%",
        "default": {
          "fontPath": "./media/usage-bars.woff",
          "fontCharacter": "\\E008"
        }
      }
    },
    "keybindings": [
      {
        "command": "cswapManager.quickSwitch",
        "key": "ctrl+alt+s",
        "mac": "ctrl+alt+s"
      },
      {
        "command": "cswapManager.switchNextAvailable",
        "key": "ctrl+alt+shift+s",
        "mac": "ctrl+alt+shift+s"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cswapManager.addAccount",
          "when": "view == cswapManager.accounts",
          "group": "navigation@0"
        },
        {
          "command": "cswapManager.refresh",
          "when": "view == cswapManager.accounts",
          "group": "navigation@1"
        },
        {
          "command": "cswapManager.quickSwitch",
          "when": "view == cswapManager.accounts",
          "group": "navigation@2"
        },
        {
          "command": "cswapManager.openDashboard",
          "when": "view == cswapManager.accounts",
          "group": "navigation@3"
        },
        {
          "command": "cswapManager.filterAccounts",
          "when": "view == cswapManager.accounts && !cswapManager.filterActive",
          "group": "w_view@1"
        },
        {
          "command": "cswapManager.clearFilter",
          "when": "view == cswapManager.accounts && cswapManager.filterActive",
          "group": "navigation@4"
        },
        {
          "command": "cswapManager.sortAccounts",
          "when": "view == cswapManager.accounts",
          "group": "w_view@2"
        },
        {
          "command": "cswapManager.quickSettings",
          "when": "view == cswapManager.accounts",
          "group": "navigation@9"
        },
        {
          "command": "cswapManager.openSettings",
          "when": "view == cswapManager.accounts",
          "group": "z_support@2"
        },
        {
          "command": "cswapManager.showDiagnostics",
          "when": "view == cswapManager.accounts",
          "group": "z_support@1"
        },
        {
          "command": "cswapManager.openClaudeForProject",
          "when": "view == cswapManager.accounts",
          "group": "x_accounts@2"
        },
        {
          "command": "cswapManager.autoSwitch",
          "when": "view == cswapManager.accounts",
          "group": "y_auto@1"
        },
        {
          "command": "cswapManager.exportAccounts",
          "when": "view == cswapManager.accounts",
          "group": "y_transfer@1"
        },
        {
          "command": "cswapManager.importAccounts",
          "when": "view == cswapManager.accounts",
          "group": "y_transfer@2"
        },
        {
          "command": "cswapManager.saveUsageReadings",
          "when": "view == cswapManager.accounts",
          "group": "y_transfer@3"
        },
        {
          "command": "cswapManager.importUsage",
          "when": "view == cswapManager.accounts",
          "group": "y_transfer@4"
        }
      ],
      "commandPalette": [
        {
          "command": "cswapManager.clearFilter",
          "when": "cswapManager.filterActive"
        },
        {
          "command": "cswapManager.switchToAccount",
          "when": "false"
        },
        {
          "command": "cswapManager.showAccountDetails",
          "when": "false"
        },
        {
          "command": "cswapManager.setDisplayName",
          "when": "false"
        },
        {
          "command": "cswapManager.removeAccount",
          "when": "false"
        },
        {
          "command": "cswapManager.exportAccount",
          "when": "false"
        },
        {
          "command": "cswapManager.disableAccount",
          "when": "false"
        },
        {
          "command": "cswapManager.enableAccount",
          "when": "false"
        },
        {
          "command": "cswapManager.setThreshold",
          "when": "false"
        },
        {
          "command": "cswapManager.clearThreshold",
          "when": "false"
        },
        {
          "command": "cswapManager.moveAccount",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "cswapManager.switchToAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:inactive:/",
          "group": "inline"
        },
        {
          "command": "cswapManager.switchToAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:inactive:/",
          "group": "1_use@1"
        },
        {
          "command": "cswapManager.showAccountDetails",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "inline"
        },
        {
          "command": "cswapManager.showAccountDetails",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "2_info@1"
        },
        {
          "command": "cswapManager.setDisplayName",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "4_organize@1"
        },
        {
          "command": "cswapManager.disableAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:.*:enabled(:|$)/",
          "group": "3_rotation@1"
        },
        {
          "command": "cswapManager.enableAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:.*:disabled(:|$)/",
          "group": "3_rotation@2"
        },
        {
          "command": "cswapManager.setThreshold",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "3_rotation@3"
        },
        {
          "command": "cswapManager.clearThreshold",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:.*:threshold(:|$)/",
          "group": "3_rotation@4"
        },
        {
          "command": "cswapManager.moveAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "4_organize@2"
        },
        {
          "command": "cswapManager.removeAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "9_danger@1"
        },
        {
          "command": "cswapManager.openClaudeAs",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "1_use@2"
        },
        {
          "command": "cswapManager.assignProjectAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "1_use@3"
        },
        {
          "command": "cswapManager.exportAccount",
          "when": "view == cswapManager.accounts && viewItem =~ /^cswap\\.account:/",
          "group": "4_organize@3"
        }
      ]
    },
    "configuration": {
      "title": "Cswap Manager",
      "properties": {
        "cswapManager.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "order": 0,
          "markdownDescription": "%config.cliPath.description%"
        },
        "cswapManager.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "en",
            "vi",
            "zh-cn",
            "zh-tw",
            "ja",
            "ko"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.vi%",
            "%config.language.zh-cn%",
            "%config.language.zh-tw%",
            "%config.language.ja%",
            "%config.language.ko%"
          ],
          "markdownDescription": "%config.language.description%",
          "order": 1
        },
        "cswapManager.refreshIntervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 3600,
          "order": 2,
          "markdownDescription": "%config.refreshIntervalSeconds.description%"
        },
        "cswapManager.statusBar.mode": {
          "type": "string",
          "default": "slotUsage",
          "enum": [
            "slotUsage",
            "slot",
            "nameUsage",
            "custom",
            "hidden"
          ],
          "enumDescriptions": [
            "%config.statusBarMode.slotUsage%",
            "%config.statusBarMode.slot%",
            "%config.statusBarMode.nameUsage%",
            "%config.statusBarMode.custom%",
            "%config.statusBarMode.hidden%"
          ],
          "order": 3,
          "markdownDescription": "%config.statusBarMode.description%"
        },
        "cswapManager.statusBar.parts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "icon",
              "slot",
              "name",
              "plan",
              "bar",
              "usage",
              "reset"
            ]
          },
          "uniqueItems": true,
          "default": [
            "icon",
            "slot",
            "usage"
          ],
          "order": 3.1,
          "markdownDescription": "%config.statusBarParts.description%"
        },
        "cswapManager.statusBar.colors": {
          "type": "string",
          "default": "background",
          "enum": [
            "background",
            "text",
            "none"
          ],
          "enumDescriptions": [
            "%config.statusBarColors.background%",
            "%config.statusBarColors.text%",
            "%config.statusBarColors.none%"
          ],
          "order": 3.3,
          "markdownDescription": "%config.statusBarColors.description%"
        },
        "cswapManager.statusBar.countdown": {
          "type": "boolean",
          "default": true,
          "order": 3.35,
          "markdownDescription": "%config.statusBarCountdown.description%"
        },
        "cswapManager.statusBar.buttons": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "refresh",
              "dashboard",
              "settings"
            ]
          },
          "uniqueItems": true,
          "default": [
            "settings"
          ],
          "order": 3.4,
          "markdownDescription": "%config.statusBarButtons.description%"
        },
        "cswapManager.confirmSwitch": {
          "type": "boolean",
          "default": true,
          "order": 4,
          "markdownDescription": "%config.confirmSwitch.description%",
          "scope": "application"
        },
        "cswapManager.autoSwitch.mode": {
          "type": "string",
          "default": "off",
          "enum": [
            "off",
            "notify",
            "switch"
          ],
          "enumDescriptions": [
            "%config.autoSwitch.off%",
            "%config.autoSwitch.notify%",
            "%config.autoSwitch.switch%"
          ],
          "scope": "application",
          "markdownDescription": "%config.autoSwitch.description%",
          "order": 5,
          "ignoreSync": true
        },
        "cswapManager.sidebar.sortOrder": {
          "type": "string",
          "default": "slot",
          "enum": [
            "slot",
            "mostUsed",
            "leastUsed",
            "soonestReset"
          ],
          "enumDescriptions": [
            "%config.sortOrder.slot%",
            "%config.sortOrder.mostUsed%",
            "%config.sortOrder.leastUsed%",
            "%config.sortOrder.soonestReset%"
          ],
          "order": 6,
          "markdownDescription": "%config.sortOrder.description%"
        },
        "cswapManager.display.warningThreshold": {
          "type": "number",
          "default": 80,
